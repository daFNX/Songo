# Entorno local. Copia este archivo a .env y genera secretos propios.
APP_ENV=development
APP_BASE_URL=http://localhost:5173
PORT=8000

# PostgreSQL administrado (Neon/Supabase) o local.
# Usa el URI de conexión directo del proveedor; no publiques este valor.
DATABASE_URL=postgresql://songo:songo@127.0.0.1:5432/songo
DATABASE_CONNECT_TIMEOUT=5

# Genera 32 bytes aleatorios como mínimo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
JWT_ISSUER=songo
SESSION_TTL_SECONDS=43200
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_PARALLELISM=2

# Funciones activas, separadas por coma. Similitud/biblioteca requieren PostgreSQL.
SONGO_ENABLED_FEATURES=bpm,recording,chords,similarity,library
SONGO_CATALOG_MAX_RESULTS=5

# Orígenes permitidos para solicitudes mutables del navegador.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
